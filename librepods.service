[Unit]
Description=librepods AirPods daemon
# The AAP link needs BlueZ and a session bus, both of which arrive with the graphical session.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Qt enables category debug output by default, and the BLE advertisement line fires several times a second.
Environment=QT_LOGGING_RULES=openpods.debug=false
ExecStart=%h/.local/bin/librepods --headless
Restart=on-failure
RestartSec=5

# The status file carries the AirPods identity, so nothing the daemon creates is world-readable.
UMask=0077
StateDirectory=librepods
StateDirectoryMode=0700
ConfigurationDirectory=AirPodsTrayApp
ConfigurationDirectoryMode=0700
# No ProtectSystem, ProtectHome, PrivateTmp, ProtectHostname or ProtectKernelTunables/ControlGroups:
# in a user unit they need an unprivileged user namespace, which Ubuntu confines to the
# unprivileged_userns AppArmor profile, and snap players (Spotify) then deny the MPRIS calls
# ear detection pauses with.
# No CapabilityBoundingSet, ProtectClock or ProtectKernelModules/Logs either: they drop
# capabilities, and a user manager has no CAP_SETPCAP to do that, so the unit fails with 218/CAPABILITIES.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
# BlueZ takes AF_BLUETOOTH, the HCI address-type probe takes AF_NETLINK, everything else is a local socket.
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH AF_NETLINK

[Install]
WantedBy=graphical-session.target
